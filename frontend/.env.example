# Copy to .env.local and fill in. Find both at sanity.io/manage -> your project.
# Leave the project ID empty to see the Journal with built-in sample posts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional. /meet embeds AMIPI's Microsoft Bookings page by default; set this
# only to point it at a different Bookings page.
NEXT_PUBLIC_BOOKINGS_URL=
