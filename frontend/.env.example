# Copy to .env.local and fill in. Find both at sanity.io/manage -> your project.
# Leave the project ID empty to see the Journal with built-in sample posts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# The site's public address, for canonical links and the sitemap. Optional on
# Vercel (its production address is used); set it once the final domain is live.
NEXT_PUBLIC_SITE_URL=

# Optional. Chats go to AMIPI's Zoho SalesIQ by default; set only to use a
# different SalesIQ brand (the "wc" value from its embed code, siq...).
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Empty = analytics off.
NEXT_PUBLIC_GA_ID=

# Google Search Console "HTML tag" verification code (the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
