# Copy to .env.local and fill in. Find both at sanity.io/manage -> your project.
# Leave the project ID empty to see the Journal with built-in sample posts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# The Calendly event behind /meet, e.g. https://calendly.com/amipi/30min
# Company, phone, address, staff and requests are sent in its first question.
# Leave empty and /meet asks visitors to email or call instead.
NEXT_PUBLIC_CALENDLY_URL=
